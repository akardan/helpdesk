<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend ticket form with task management -->
    <record id="helpdesk_ticket_view_form_task" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.tasks</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <!-- Smart button for tasks -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_tasks" type="object"
                        class="oe_stat_button" icon="fa-tasks"
                        invisible="task_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Tasks</span>
                        <span class="o_stat_value">
                            <field name="open_task_count"/> / <field name="task_count"/>
                        </span>
                    </div>
                </button>
            </xpath>

            <!-- Actions in header -->
            <xpath expr="//header" position="inside">
                <button name="action_create_onsite_task" string="Add On-Site Task"
                        type="object" icon="fa-map-marker"
                        invisible="has_onsite_tasks"/>
            </xpath>

            <!-- Progress bar near priority -->
            <xpath expr="//field[@name='priority']" position="after">
                <field name="overall_task_progress" widget="progressbar"
                       invisible="task_count == 0"/>
            </xpath>

            <!-- Tasks tab in notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Tasks" name="tasks">
                    <div class="o_row mb4">
                        <button name="action_view_tasks" type="object"
                                string="Open Full View" class="btn-secondary btn-sm"/>
                        <button name="action_create_onsite_task" type="object"
                                string="+ On-Site Task" class="btn-primary btn-sm ml4"/>
                    </div>
                    <field name="task_ids" domain="[('parent_id','=',False)]" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="task_type"/>
                            <field name="state" widget="badge"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="date_deadline"/>
                            <field name="child_count" string="Sub-Tasks"/>
                        </tree>
                    </field>
                    <separator string="Milestones" invisible="not milestone_ids"/>
                    <field name="milestone_ids" invisible="not milestone_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="date_deadline"/>
                            <field name="task_count"/>
                            <field name="reached"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
