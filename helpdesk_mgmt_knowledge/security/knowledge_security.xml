<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="knowledge_article_rule_user" model="ir.rule">
            <field name="name">Helpdesk User: own team articles</field>
            <field name="model_id" ref="model_helpdesk_knowledge_article"/>
            <field name="domain_force">[('team_ids', 'in', [team.id for team in user.helpdesk_team_ids])]</field>
            <field name="groups" eval="[(4, ref('helpdesk_mgmt.group_helpdesk_user'))]"/>
        </record>
    </data>
</odoo>
