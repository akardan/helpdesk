<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="svc_cat_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.service.category.kanban</field>
        <field name="model">helpdesk.service.category</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="department_id"/>
                <field name="icon"/>
                <field name="service_item_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value} oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <i t-att-class="'fa ' + record.icon.raw_value + ' fa-2x mr8'"/>
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="department_id" widget="badge"/>
                                <span class="ml8"><field name="service_item_count"/> services</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="svc_cat_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.service.category.tree</field>
        <field name="model">helpdesk.service.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="team_id"/>
                <field name="service_item_count"/>
            </tree>
        </field>
    </record>

    <record id="svc_cat_view_form" model="ir.ui.view">
        <field name="name">helpdesk.service.category.form</field>
        <field name="model">helpdesk.service.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Service Category Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="team_id"/>
                            <field name="icon"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe this service category..."/>
                    <separator string="Service Items"/>
                    <field name="service_item_ids">
                        <tree>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="sla_resolution_hours"/>
                            <field name="requires_approval"/>
                            <field name="requires_physical_access"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="svc_cat_action" model="ir.actions.act_window">
        <field name="name">Service Catalog</field>
        <field name="res_model">helpdesk.service.category</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <!-- Top-level menu entry for the service catalog -->
    <menuitem id="menu_service_catalog_root" name="Service Catalog"
              parent="helpdesk_mgmt.helpdesk_ticket_menu" sequence="5"/>
    <menuitem id="menu_service_catalog" name="Catalog"
              parent="menu_service_catalog_root"
              action="svc_cat_action" sequence="10"/>
</odoo>
