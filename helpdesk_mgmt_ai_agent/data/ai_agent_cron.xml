<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron job to process unclassified tickets -->
        <record id="ir_cron_ai_process_tickets" model="ir.cron">
            <field name="name">Helpdesk: AI Process Unclassified Tickets</field>
            <field name="model_id" ref="model_helpdesk_ai_agent"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_unclassified_tickets()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
