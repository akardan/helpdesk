<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

<!-- ═══════════════════════════════════════════════════════════
     IT Stage Templates
═══════════════════════════════════════════════════════════ -->
<record id="stage_it_new"           model="helpdesk.department.stage"><field name="name">New</field>               <field name="sequence">1</field><field name="department_type">it</field><field name="unattended" eval="True"/></record>
<record id="stage_it_progress"      model="helpdesk.department.stage"><field name="name">In Progress</field>       <field name="sequence">2</field><field name="department_type">it</field></record>
<record id="stage_it_awaiting"      model="helpdesk.department.stage"><field name="name">Awaiting User</field>     <field name="sequence">3</field><field name="department_type">it</field></record>
<record id="stage_it_pending_chg"   model="helpdesk.department.stage"><field name="name">Pending Change</field>    <field name="sequence">4</field><field name="department_type">it</field></record>
<record id="stage_it_resolved"      model="helpdesk.department.stage"><field name="name">Resolved</field>          <field name="sequence">5</field><field name="department_type">it</field><field name="closed" eval="True"/></record>
<record id="stage_it_closed"        model="helpdesk.department.stage"><field name="name">Closed</field>            <field name="sequence">6</field><field name="department_type">it</field><field name="closed" eval="True"/><field name="fold" eval="True"/></record>

<!-- ═══════════════════════════════════════════════════════════
     HR Stage Templates
═══════════════════════════════════════════════════════════ -->
<record id="stage_hr_received"      model="helpdesk.department.stage"><field name="name">Received</field>          <field name="sequence">1</field><field name="department_type">hr</field><field name="unattended" eval="True"/></record>
<record id="stage_hr_review"        model="helpdesk.department.stage"><field name="name">Under Review</field>      <field name="sequence">2</field><field name="department_type">hr</field></record>
<record id="stage_hr_approval"      model="helpdesk.department.stage"><field name="name">Pending Approval</field>  <field name="sequence">3</field><field name="department_type">hr</field></record>
<record id="stage_hr_approved"      model="helpdesk.department.stage"><field name="name">Approved</field>          <field name="sequence">4</field><field name="department_type">hr</field></record>
<record id="stage_hr_completed"     model="helpdesk.department.stage"><field name="name">Completed</field>         <field name="sequence">5</field><field name="department_type">hr</field><field name="closed" eval="True"/></record>
<record id="stage_hr_rejected"      model="helpdesk.department.stage"><field name="name">Rejected</field>          <field name="sequence">6</field><field name="department_type">hr</field><field name="closed" eval="True"/><field name="fold" eval="True"/></record>

