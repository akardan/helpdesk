<record id="stage_fin_review"       model="helpdesk.department.stage"><field name="name">Under Review</field>      <field name="sequence">2</field><field name="department_type">finance</field></record>
<record id="stage_fin_docs"         model="helpdesk.department.stage"><field name="name">Pending Documents</field> <field name="sequence">3</field><field name="department_type">finance</field></record>
<record id="stage_fin_process"      model="helpdesk.department.stage"><field name="name">In Process</field>        <field name="sequence">4</field><field name="department_type">finance</field></record>
<record id="stage_fin_completed"    model="helpdesk.department.stage"><field name="name">Completed</field>         <field name="sequence">5</field><field name="department_type">finance</field><field name="closed" eval="True"/></record>
