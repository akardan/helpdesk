<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default Priority Levels (ITIL-based) -->
        <record id="priority_critical" model="helpdesk.ticket.priority">
            <field name="name">Critical</field>
            <field name="value">3</field>
            <field name="sequence">10</field>
            <field name="description">Urgent issues with high business impact requiring immediate attention</field>
            <field name="color">1</field>
        </record>

        <record id="priority_high" model="helpdesk.ticket.priority">
            <field name="name">High</field>
            <field name="value">2</field>
            <field name="sequence">20</field>
            <field name="description">Important issues with significant business impact</field>
            <field name="color">3</field>
        </record>

        <record id="priority_medium" model="helpdesk.ticket.priority">
            <field name="name">Medium</field>
            <field name="value">1</field>
            <field name="sequence">30</field>
            <field name="description">Standard priority issues</field>
            <field name="color">4</field>
        </record>

        <record id="priority_low" model="helpdesk.ticket.priority">
            <field name="name">Low</field>
            <field name="value">0</field>
            <field name="sequence">40</field>
            <field name="description">Minor issues with low business impact</field>
            <field name="color">10</field>
        </record>

    </data>
</odoo>
