<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron job to monitor SLA and trigger escalations -->
        <record id="ir_cron_sla_monitor" model="ir.cron">
            <field name="name">Helpdesk: SLA Monitor and Escalation</field>
            <field name="model_id" ref="model_helpdesk_sla_status"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_sla_escalation()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>

        <!-- Cron job to re-apply SLA policies to tickets without SLA -->
        <record id="ir_cron_sla_apply" model="ir.cron">
            <field name="name">Helpdesk: Apply SLA Policies</field>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model.cron_apply_sla_policies()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
